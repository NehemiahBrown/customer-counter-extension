{
  "manifest_version": 3,
  "name": "Customer Count Tracker",
  "description": "Track the number of customers for the last hour of work.",
  "version": "1.1.0",
  "action": {
    "default_title": "Customer Counter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "permissions": ["storage", "alarms", "notifications"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
